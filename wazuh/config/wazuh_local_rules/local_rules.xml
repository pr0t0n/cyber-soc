<!-- Example -->
<group name="local,syslog,sshd,">

  <!--
  Dec 10 01:02:02 host sshd[1234]: Failed none for root from 1.1.1.1 port 1066 ssh2
  -->
  <rule id="100001" level="5">
    <if_sid>5716</if_sid>
    <srcip>1.1.1.1</srcip>
    <description>sshd: authentication failed from IP 1.1.1.1.</description>
    <group>authentication_failed,pci_dss_10.2.4,pci_dss_10.2.5,</group>
  </rule>

</group>

<!-- Suricata não roda mais como processo/container separado nesta
     plataforma — a antiga regra filha aqui (id 100002, refinando o wrapper
     genérico 0475-suricata_rules.xml/id 86601 para a assinatura customizada
     sid:9000001) nunca mais casaria, porque nenhum alerta de origem Suricata
     chega ao Wazuh. Detecção de port scan (mapeada para T1595, MITRE
     Reconnaissance) agora vem da correlação por volume/burst sobre os
     próprios eventos recebidos (app/services/correlation.py + baseline.py),
     não de uma assinatura de rede ao vivo. -->
