# Copy to .env for `docker compose up`. Never commit a real .env.

ENV=development

# Overridden per-service in docker-compose.yml for postgres/api; harmless here.
DATABASE_URL=postgresql+asyncpg://soc:soc@postgres:5432/cyber_soc

JWT_SECRET=troque-esta-chave-em-producao

BOOTSTRAP_ADMIN_NAME=Administrador
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=admin123

# Local LLM (Ollama, see docker-compose.yml `ollama` service). Point at a real
# OpenAI-compatible gateway in staging/production instead.
LLM_BASE_URL=http://ollama:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen2.5:1.5b
# CPU inference can be slow, especially cold-start after a fresh `ollama pull`
# or on a host busy with other containers — keep this generous.
LLM_TIMEOUT_SECONDS=120

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4300

# Geolocalização do IP de origem (world map do dashboard), via ipinfo.io — sem
# token nesta versão (limite gratuito por IP/dia). Desligue se preferir não
# fazer chamadas externas na ingestão.
AUTO_GEO_ON_INGEST=true
